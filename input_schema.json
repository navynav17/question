{
  "title": "CEE MCQ all-chapters extractor",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrls": {
      "title": "Discovery URLs",
      "type": "array",
      "description": "Subject/index pages used to discover all /chapter/<slug>/ pages.",
      "editor": "requestListSources",
      "default": [
        { "url": "https://pandeyramu.com.np/all-subjects/" },
        { "url": "https://pandeyramu.com.np/subject/physics/" },
        { "url": "https://pandeyramu.com.np/subject/chemistry/" },
        { "url": "https://pandeyramu.com.np/subject/botany/" },
        { "url": "https://pandeyramu.com.np/subject/zoology/" },
        { "url": "https://pandeyramu.com.np/subject/mat/" }
      ],
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "title": "URL",
            "type": "string",
            "editor": "textfield"
          }
        },
        "required": ["url"]
      }
    },
    "maxConcurrency": {
      "title": "Max concurrency",
      "type": "integer",
      "default": 2,
      "minimum": 1,
      "maximum": 5
    },
    "maxRequests": {
      "title": "Maximum pages per run",
      "type": "integer",
      "default": 1000,
      "minimum": 10,
      "maximum": 5000
    }
  },
  "required": ["startUrls"]
}