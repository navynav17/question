{
  "title": "Ramu Pandey MCQ extractor",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrls": {
      "title": "MCQ discovery URLs",
      "type": "array",
      "description": "Use https://pandeyramu.com.np/mcq/ or any MCQ index page.",
      "editor": "requestListSources",
      "default": [
        { "url": "https://pandeyramu.com.np/mcq/" }
      ],
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "title": "URL",
            "type": "string",
            "editor": "textfield"
          }
        },
        "required": ["url"]
      }
    },
    "maxConcurrency": {
      "title": "Max concurrency",
      "type": "integer",
      "default": 2,
      "minimum": 1,
      "maximum": 5
    },
    "maxRequests": {
      "title": "Maximum pages per run",
      "type": "integer",
      "default": 2000,
      "minimum": 10,
      "maximum": 5000
    }
  },
  "required": ["startUrls"]
}